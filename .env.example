# API
BASE_API_URL=https://api.example.com
ENVIRONMENT=development

# Library (texts) API. Reader, search and the chant list read from here.
# LIBRARY_CHANTS_TAG_ID is required: it is the library tag that marks chants.
LIBRARY_API_URL=https://library.webuddhist.com
LIBRARY_CHANTS_TAG_ID=

# Auth0 (optional — can also be fetched from /props)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_SCHEME=

# PostHog (one project per flavor — use different tokens in .env.dev / .env.staging / .env.prod)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=true

# Microsoft Clarity session recordings + heatmaps. One project can serve every
# flavor: sessions carry `environment` / `app_flavor` tags for filtering.
# Leave CLARITY_PROJECT_ID empty to disable Clarity.
CLARITY_PROJECT_ID=
CLARITY_ENABLED=

# Tolgee over-the-air translations. Content Delivery is public, so no key is
# needed: a CDN URL turns Tolgee on, TOLGEE_ENABLED=false turns it off, and
# without a URL the app uses the bundled ARB only. The .env files ship inside
# the APK/IPA, so never put a write-capable Tolgee key here.
#
# TOLGEE_CDN_URL is a prefix only — the app appends /{language}.json.
# Include the Content Delivery namespace in the prefix:
#   https://cdn.tolg.ee/<id>/webuddhist
# Published files: en, bo-IN, zh-Hant-TW, hi, mn, ne under that namespace.
TOLGEE_CDN_URL=https://cdn.tolg.ee/<content-delivery-id>/webuddhist
TOLGEE_ENABLED=
