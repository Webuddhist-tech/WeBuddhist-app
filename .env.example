# API
BASE_API_URL=https://api.example.com
AI_URL=https://aichat.example.com
ENVIRONMENT=development

# Auth0 (optional — can also be fetched from /props)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_SCHEME=

# PostHog (one project per flavor — use different tokens in .env.dev / .env.staging / .env.prod)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=true

# Tolgee over-the-air translations.
# TOLGEE_API_KEY must be a READ-ONLY scoped project key (translations.view,
# languages.view). The .env files are bundled as app assets, so anything here
# ships inside the APK/IPA and can be extracted.
# Leave TOLGEE_API_KEY empty to disable Tolgee and use the bundled ARB only.
#
# TOLGEE_CDN_URL is a prefix only — the SDK appends /{language}.json.
# Include the Content Delivery namespace in the prefix when Tolgee requires one:
#   https://cdn.tolg.ee/<id>/webuddhist
# Published files: en, bo-IN, zh-Hant-TW, hi, mn, ne under that namespace.
TOLGEE_API_URL=https://app.tolgee.io/v2
TOLGEE_API_KEY=
TOLGEE_CDN_URL=https://cdn.tolg.ee/<content-delivery-id>/webuddhist
TOLGEE_ENABLED=
