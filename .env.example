# API
BASE_API_URL=https://api.example.com
ENVIRONMENT=development

# Library (texts) API. Reader, search and the chant list read from here.
# LIBRARY_CHANTS_TAG_ID is required: it is the library tag that marks chants.
LIBRARY_API_URL=https://library.webuddhist.com
LIBRARY_CHANTS_TAG_ID=

# Auth0 (optional — can also be fetched from /props)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_SCHEME=

# PostHog (one project per flavor — use different tokens in .env.dev / .env.staging / .env.prod)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=true

# Microsoft Clarity session recordings + heatmaps. One project can serve every
# flavor: sessions carry `environment` / `app_flavor` tags for filtering.
# Leave CLARITY_PROJECT_ID empty to disable Clarity.
CLARITY_PROJECT_ID=
CLARITY_ENABLED=
